---
/**
 * Twitch clips — made by viewers, not by the owner, which is the whole reason
 * they get their own page and carry a credit.
 *
 * Paginated from the start, which the backfill then justified: the page went
 * from 31 clips to 471 in one commit, back to 2023, without the route or any
 * link to it changing.
 *
 * Filtering and sorting are layered on top rather than replacing that — see
 * ArchiveFilter for how the two views coexist. This page is the one that also
 * sorts by view count, which is why the weekly reconciliation stores it.
 */
import type { GetStaticPaths, Page } from 'astro';
import Base from '../../layouts/Base.astro';
import MediaCard from '../../components/MediaCard.astro';
import ArchiveFilter from '../../components/ArchiveFilter.astro';
import type { Clip } from '../../lib/content';
import { clips } from '../../lib/content';
import { clipLabel } from '../../lib/clip-title';

export const getStaticPaths = (async ({ paginate }) => {
  const { clips } = await import('../../lib/content');
  return paginate(clips, { pageSize: 48 });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<Clip> };

const title = page.currentPage === 1 ? 'Klipy' : `Klipy — strana ${page.currentPage}`;

/** One place the card's props are decided, so the two views cannot drift. */
const cardProps = (clip: Clip) =>
  ({
    href: clip.url,
    title: clipLabel(clip).text,
    thumb: clip.thumb,
    date: clip.date,
    duration: clip.duration,
    meta: clip.creator ? `klip: ${clip.creator}` : undefined,
    badge: clip.featured ? 'Doporučeno' : undefined,
    badgeAt: 'bottom-left',
    views: clip.views,
  }) as const;

// The archive is already sorted newest-first, so its own ends are the bounds
// the date pickers should offer — no point letting someone pick 2019.
const newest = clips[0]?.date.slice(0, 10) ?? '';
const oldest = clips.at(-1)?.date.slice(0, 10) ?? '';
---
<Base
  title={title}
  description="Klipy z Twitche — nejlepší momenty, které nastříhali diváci."
>
  <div class="container">
    <h1>Klipy z <span class="accent">Twitche</span></h1>
    <p class="muted intro">
      {clips.length} momentů, které nastříhali diváci, od nejnovějšího. Klipy na Twitchi
      nemizí, takže tady zůstávají až do roku 2023 — na rozdíl od záznamů streamů,
      které proto sbírám na <a href="/streamy/">YouTube</a>.
    </p>

    <ArchiveFilter
      nouns={['klip', 'klipy', 'klipů']}
      pageSize={48}
      oldest={oldest}
      newest={newest}
      searchHint="název nebo autor klipu…"
      sorts={[
        { value: 'nejnovejsi', label: 'Nejnovější' },
        { value: 'nejstarsi', label: 'Nejstarší' },
        { value: 'nejsledovanejsi', label: 'Nejsledovanější' },
      ]}
    >
      <Fragment slot="results">
        {/* Every clip, inert until something is filtered. */}
        <template data-pool>
          {clips.map((clip) => <MediaCard {...cardProps(clip)} />)}
        </template>
        <div class="grid" data-results></div>
      </Fragment>

      <Fragment slot="server">
        <div class="grid">
          {page.data.map((clip, index) => (
            <MediaCard {...cardProps(clip)} eager={index < 4} />
          ))}
        </div>

        {(page.url.prev || page.url.next) && (
          <nav class="pager" aria-label="Stránkování">
            {page.url.prev ? <a href={page.url.prev}>← Novější</a> : <span class="muted">← Novější</span>}
            <span class="muted count">Strana {page.currentPage} z {page.lastPage}</span>
            {page.url.next ? <a href={page.url.next}>Starší →</a> : <span class="muted">Starší →</span>}
          </nav>
        )}
      </Fragment>
    </ArchiveFilter>
  </div>
</Base>

<style>
  h1 {
    margin-top: 2rem;
    font-size: clamp(2rem, 7vw, 3.4rem);
    text-transform: uppercase;
  }
  .accent {
    color: var(--accent);
  }
  .intro {
    max-width: 54ch;
    margin-bottom: 2rem;
  }

  /* Two columns on a phone rather than one full-width card per screen: this is
     an archive of several hundred clips meant for browsing. A 160px thumbnail
     is still plenty to recognise a clip by. */
  .grid {
    display: grid;
    gap: 1.2rem 0.9rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 10rem), 1fr));
    margin-bottom: 2rem;
  }
  @media (min-width: 40rem) {
    .grid {
      gap: 1.4rem 1.1rem;
      grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    }
  }

  .pager {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.4rem;
    align-items: center;
    justify-content: space-between;
    margin-block: 2rem 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--card-edge);
  }
  .pager a {
    font-weight: 600;
  }
  .count {
    font-size: 0.9rem;
  }
</style>
