---
import Base from '../layouts/Base.astro';
import ScheduleCompact from '../components/ScheduleCompact.astro';
import TwitchEmbed from '../components/TwitchEmbed.astro';
import SocialLinks from '../components/SocialLinks.astro';
import LatestContent from '../components/LatestContent.astro';
---
<Base title="KeodaCZ" description="KeodaCZ — český streamer. Twitch, YouTube a spol.">
  <div class="container">
    <section class="hero">
      <h1>KeodaCZ</h1>
      <p class="muted tagline">Český streamer — Twitch, YouTube a spol.</p>

      {/* Above the socials row, not below it (owner's call 2026-09-07): while
          a stream is running it is the reason anyone opened the page, and on
          a phone the eight chips would push it under the fold. It renders
          nothing at all when the channel is offline. */}
      <TwitchEmbed />

      {/* No Twitch button here on purpose — the socials row directly below
          opens with a Twitch chip, so a second one just says it twice. */}
      <SocialLinks />
    </section>

    {/* DOM order is the phone's reading order, and it is deliberate: is he on
        now (above), when is he next on, what can I watch, and only then what
        he streams on. Gear is the least urgent thing here for someone
        arriving from a social bio, so it goes last in the markup — the desktop
        layout then places it back up beside the schedule explicitly. */}
    <div class="panels">
      <ScheduleCompact />

      <LatestContent />

      <section class="card gear">
        <h2>Vybavení</h2>
        <p>Na čem streamuju — PC sestava, technika i software.</p>
        <p class="more"><a href="/vybaveni/">Prohlédnout vybavení →</a></p>
      </section>
    </div>

  </div>
</Base>

<style>
  .hero {
    padding-block: 2.6rem 2rem;
  }
  .hero h1 {
    font-size: clamp(2.4rem, 8vw, 3.6rem);
    text-transform: uppercase;
    margin-bottom: 0.1em;
  }
  .tagline {
    font-size: 1.05rem;
    margin-bottom: 1.3rem;
  }

  .panels {
    display: grid;
    gap: 1.2rem;
    align-items: start;
  }
  .panels :global(.card) {
    margin-bottom: 0;
  }
  @media (min-width: 800px) {
    .panels {
      grid-template-columns: 3fr 2fr;
    }
    /* Explicit placement rather than source order: the markup is ordered for
       the phone, so the two-column layout has to put gear back on the first
       row beside the schedule and give the newest content the full width
       below it. */
    .gear {
      grid-column: 2;
      grid-row: 1;
    }
    .panels :global(.latest) {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
