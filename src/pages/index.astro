---
import Base from '../layouts/Base.astro';
import ScheduleCompact from '../components/ScheduleCompact.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { TWITCH_URL } from '../lib/stream-event';
---
<Base title="KeodaCZ" description="KeodaCZ — český streamer. Twitch, YouTube a spol.">
  <div class="container">
    <section class="hero">
      <h1>KeodaCZ</h1>
      <p class="muted tagline">Český streamer — Twitch, YouTube a spol.</p>
      <a class="btn" href={TWITCH_URL} target="_blank" rel="noopener">▶ Sledovat na Twitchi</a>
      <SocialLinks />
    </section>

    <div class="panels">
      <ScheduleCompact />

      <section class="card">
        <h2>Vybavení</h2>
        <p>Na čem streamuju — PC sestava, technika i software.</p>
        <p class="more"><a href="/vybaveni/">Prohlédnout vybavení →</a></p>
      </section>
    </div>

  </div>
</Base>

<style>
  .hero {
    padding-block: 2.6rem 2rem;
  }
  .hero h1 {
    font-size: clamp(2.4rem, 8vw, 3.6rem);
    text-transform: uppercase;
    margin-bottom: 0.1em;
  }
  .tagline {
    font-size: 1.05rem;
    margin-bottom: 1.3rem;
  }
  .hero :global(.btn) {
    margin-bottom: 1.3rem;
  }

  .panels {
    display: grid;
    gap: 1.2rem;
    align-items: start;
  }
  .panels :global(.card) {
    margin-bottom: 0;
  }
  @media (min-width: 800px) {
    .panels {
      grid-template-columns: 3fr 2fr;
    }
  }
</style>
