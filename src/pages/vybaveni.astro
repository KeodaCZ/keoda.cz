---
import Base from '../layouts/Base.astro';
import gear from '../../data/gear.json';
---
<Base
  title="Vybavení"
  description="Na čem KeodaCZ streamuje — PC sestava, periferie, audio/video technika a software."
>
  <div class="container">
    <h1>Vybavení</h1>
    <p class="muted intro">Na čem streamuju a co k tomu používám.</p>

    <div class='grid'>
    {gear.categories.map((category) => (
      <section class="card">
        <h2>{category.name}</h2>
        <ul>
          {category.items.map((item) => (
            <li>
              {item.label ? <><strong>{item.label}:</strong> {item.name}</> : item.name}
              {/* Optional, and only where it earns its place: a line saying
                  what a thing is for. Hardware mostly explains itself from
                  its label; software does not. */}
              {item.note && <span class="note muted">{item.note}</span>}
            </li>
          ))}
        </ul>
      </section>
    ))}
    </div>
  </div>
</Base>

<style>
  h1 {
    margin-top: 2rem;
  }
  .intro {
    margin-bottom: 1.6rem;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
  }
  .grid .card {
    margin-bottom: 0;
  }
  @media (min-width: 800px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  ul {
    margin: 0;
    padding-left: 1.2rem;
  }
  li {
    margin-bottom: 0.3rem;
  }
  /* Its own line rather than trailing the name: at two columns the names are
     already close to wrapping, and a note tacked on made them ragged. */
  .note {
    display: block;
    font-size: 0.85rem;
    line-height: 1.4;
  }
  li:has(.note) {
    margin-bottom: 0.7rem;
  }
</style>
