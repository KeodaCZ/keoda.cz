---
/**
 * The stream archive — the bulk of the site's content: 400+ recordings, median
 * length four and a half hours.
 *
 * Tiles rather than the list it started as (owner's call 2026-09-08), with a
 * ZÁZNAM tag on each thumbnail so a recording is never mistaken for an edited
 * video. Still grouped by month, which makes the shape of the archive legible
 * — including the two-month gap in 2023 and the whole of 2024, both of which
 * are real (see the note under the heading).
 */
import type { GetStaticPaths, Page } from 'astro';
import Base from '../../layouts/Base.astro';
import MediaCard from '../../components/MediaCard.astro';
import type { Stream } from '../../lib/content';
import { streams, youtubeThumb } from '../../lib/content';
import { groupByMonth, youtubeUrl } from '../../lib/content-core';

export const getStaticPaths = (async ({ paginate }) => {
  const { streams } = await import('../../lib/content');
  return paginate(streams, { pageSize: 48 });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<Stream> };
const months = groupByMonth(page.data);

const title = page.currentPage === 1 ? 'Streamy' : `Streamy — strana ${page.currentPage}`;
---
<Base
  title={title}
  description="Archiv streamů KeodaCZ — záznamy na YouTube, od nejnovějšího."
>
  <div class="container">
    <h1>Archiv <span class="accent">streamů</span></h1>
    <p class="muted intro">
      {streams.length} záznamů na YouTube, od nejnovějšího. Streamuju na Twitchi a zároveň
      na YouTube, takže tam záznamy zůstávají — na Twitchi po chvíli mizí.
      Proto archiv začíná až rokem 2025: dřív jsem multistreamoval jen krátce na zkoušku.
    </p>

    {months.map((month, monthIndex) => (
      <section class="month">
        <h2>{month.label}</h2>
        <div class="grid">
          {month.items.map((stream, index) => (
            <MediaCard
              href={youtubeUrl(stream.id)}
              title={stream.title}
              thumb={youtubeThumb(stream)}
              date={stream.date}
              duration={stream.duration}
              badge="Záznam"
              eager={monthIndex === 0 && index < 4}
            />
          ))}
        </div>
      </section>
    ))}

    {(page.url.prev || page.url.next) && (
      <nav class="pager" aria-label="Stránkování">
        {page.url.prev ? <a href={page.url.prev}>← Novější</a> : <span class="muted">← Novější</span>}
        <span class="muted count">Strana {page.currentPage} z {page.lastPage}</span>
        {page.url.next ? <a href={page.url.next}>Starší →</a> : <span class="muted">Starší →</span>}
      </nav>
    )}
  </div>
</Base>

<style>
  h1 {
    margin-top: 2rem;
    font-size: clamp(2rem, 7vw, 3.4rem);
    text-transform: uppercase;
  }
  .accent {
    color: var(--accent);
  }
  .intro {
    max-width: 56ch;
    margin-bottom: 2.4rem;
  }

  .month {
    margin-bottom: 2.4rem;
  }
  .month h2 {
    position: sticky;
    top: 0;
    z-index: 2;
    /* Opaque, or the tiles scroll visibly through the heading. */
    background: var(--bg-top);
    margin-bottom: 0.9rem;
    padding-block: 0.45rem;
    border-bottom: 1px solid var(--card-edge);
    font-size: 1.05rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .grid {
    display: grid;
    gap: 1.2rem 0.9rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 10rem), 1fr));
  }
  @media (min-width: 40rem) {
    .grid {
      gap: 1.4rem 1.1rem;
      grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    }
  }

  .pager {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.4rem;
    align-items: center;
    justify-content: space-between;
    margin-block: 2rem 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--card-edge);
  }
  .pager a {
    font-weight: 600;
  }
  .count {
    font-size: 0.9rem;
  }
</style>
