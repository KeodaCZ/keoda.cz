---
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---
<footer>
  <div class="container inner">
    <SocialLinks variant="icons" />
    <p class="copy muted">© {year} KeodaCZ</p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--card-edge);
    margin-top: 3rem;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    padding-block: 1rem;
    font-size: 0.85rem;
  }
  .copy {
    margin: 0;
  }
</style>
