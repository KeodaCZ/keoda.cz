---
---
<header>
  <div class="container inner">
    <a class="logo" href="/">KEODACZ</a>
    {/* Three siblings rather than a nested wrapper, so the nav can take a row
        of its own on a phone while the logo and the toggle share the first. */}
    <nav>
      <a href="/kalendar/">Kalendář</a>
      <a href="/streamy/">Streamy</a>
      <a href="/videa/">Videa</a>
      <a href="/klipy/">Klipy</a>
      <a href="/vybaveni/">Vybavení</a>
    </nav>
    <button id="theme-toggle" type="button" title="Vzhled: automaticky">🌓</button>
  </div>
</header>

<style>
  header {
    border-bottom: 1px solid var(--card-edge);
  }
  /* Five links plus the logo and the toggle do not fit a phone on one line.
     They wrap rather than hiding behind a hamburger — no JavaScript, nothing
     to open, every destination visible. */
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.2rem;
    padding-block: 0.8rem;
  }
  .logo {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--text);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    /* Pushes the nav and the toggle to the right on a wide screen. */
    margin-left: auto;
  }

  /* Narrow: the nav gets its own row and the toggle stays up beside the logo.
     Letting all three wrap freely put the toggle alone on a third line and
     made the header 159px tall before any content. */
  @media (max-width: 46rem) {
    nav {
      order: 3;
      flex-basis: 100%;
      margin-left: 0;
    }
    #theme-toggle {
      margin-left: auto;
    }
  }
  nav a {
    font-weight: 600;
    text-decoration: none;
  }
  nav a:hover {
    text-decoration: underline;
  }
  #theme-toggle {
    background: none;
    border: 1px solid var(--card-edge);
    border-radius: 6px;
    padding: 0.25rem 0.55rem;
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    color: var(--text);
  }
  #theme-toggle:hover {
    background: var(--card);
  }
</style>

<script>
  // Theme cycle: auto (follow system) -> light -> dark -> auto.
  // Choice persists in localStorage; 'auto' means no entry.
  const KEY = 'theme';
  const btn = document.getElementById('theme-toggle')!;

  const read = (): string | null => {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  };

  const write = (mode: string | null) => {
    try {
      if (mode) localStorage.setItem(KEY, mode);
      else localStorage.removeItem(KEY);
    } catch {
      /* private mode etc. — toggle still works for this page view */
    }
  };

  const apply = (mode: string | null) => {
    const root = document.documentElement;
    if (mode) root.dataset.theme = mode;
    else delete root.dataset.theme;
    btn.textContent = mode === 'light' ? '☀️' : mode === 'dark' ? '🌙' : '🌓';
    btn.title =
      mode === 'light'
        ? 'Vzhled: světlý (klikni pro tmavý)'
        : mode === 'dark'
          ? 'Vzhled: tmavý (klikni pro automatický)'
          : 'Vzhled: automaticky podle systému (klikni pro světlý)';
  };

  apply(read());

  btn.addEventListener('click', () => {
    const next =
      read() === null ? 'light' : read() === 'light' ? 'dark' : null;
    write(next);
    apply(next);
  });
</script>
