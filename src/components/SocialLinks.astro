---
/**
 * Row of social profile links.
 *
 * Icons are inlined as SVG paths at build time, so there is no icon font and
 * no runtime request. Rendered in Keoda's palette rather than each brand's
 * colours: eight different brand colours in one row would fight the site's
 * own identity.
 */
import * as simpleIcons from 'simple-icons';
import { rankone } from '../icons/rankone';
import data from '../../data/socials.json';

interface Social {
  name: string;
  url: string;
  icon: string | null;
}

interface Glyph {
  viewBox: string;
  paths: string[];
}

/** Icons that simple-icons does not carry. */
const EXTRA: Record<string, Glyph> = { rankone };

function glyphFor(slug: string | null): Glyph | null {
  if (!slug) return null;
  if (EXTRA[slug]) return EXTRA[slug];

  const key = 'si' + slug.charAt(0).toUpperCase() + slug.slice(1);
  const icon = (simpleIcons as Record<string, { path: string } | undefined>)[key];
  return icon ? { viewBox: '0 0 24 24', paths: [icon.path] } : null;
}

const socials = (data.socials as Social[]).map((social) => ({
  ...social,
  glyph: glyphFor(social.icon),
}));

// A missing icon would be a typo in the data or a renamed brand — say so at
// build time instead of quietly shipping a row with a hole in it.
const missing = socials.filter((social) => !social.glyph).map((social) => social.name);
if (missing.length > 0) {
  console.warn(`\n⚠  SocialLinks: chybí ikona pro ${missing.join(', ')}.\n`);
}
---
<nav class="socials" aria-label="Sociální sítě">
  <ul>
    {socials.map((social) => (
      <li>
        <a href={social.url} target="_blank" rel="noopener">
          {social.glyph && (
            <svg viewBox={social.glyph.viewBox} aria-hidden="true" focusable="false">
              {social.glyph.paths.map((path) => (
                <path d={path} />
              ))}
            </svg>
          )}
          <span>{social.name}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  a {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    /* Roomy enough to hit with a thumb — most traffic arrives on a phone. */
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--card-edge);
    border-radius: 999px;
    background: var(--card);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--text);
  }
  a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  svg {
    width: 1.05rem;
    height: 1.05rem;
    flex: none;
    /* currentColor so the icon follows the link, including on hover. */
    fill: currentColor;
  }
</style>
