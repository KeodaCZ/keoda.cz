---
import { getUpcomingDays, scheduleNote, type ScheduleDay } from '../lib/schedule';

const days = getUpcomingDays(14);

const WEEKDAY_SHORT: Record<string, string> = {
  pondělí: 'PO',
  úterý: 'ÚT',
  středa: 'ST',
  čtvrtek: 'ČT',
  pátek: 'PÁ',
  sobota: 'SO',
  neděle: 'NE',
};

/** Main label of a row: the game if we know it, otherwise a plain "Stream". */
function rowTitle(day: ScheduleDay): string {
  if (!day.streaming) return 'Nestreamuju';
  return day.game ?? 'Stream';
}
---
<section class="schedule">
  <h2 class="title">
    <span>Příští</span> <span class="outline">streamy</span>
  </h2>
  <p class="muted lead">
    Časy jsou v českém čase a jsou přibližné — sleduj Twitch, ať ti nic neuteče.
  </p>

  <p class="cta-wrap">
    <a class="cta" href="https://www.twitch.tv/keodacz" target="_blank" rel="noopener">
      🔔 Dej vědět, až budu live
    </a>
  </p>

  {days.length === 0 ? (
    <p class="muted">Zatím tu nic nesvítí — rozvrh se doplní.</p>
  ) : (
    <ul>
      {days.map((day) => (
        <li class:list={['row', { off: !day.streaming, today: day.isToday }]}>
          <span class="badge">
            <span class="badge-day">{day.dayMonth}</span>
            <span class="badge-weekday">{WEEKDAY_SHORT[day.weekday]}</span>
          </span>

          <span class="body">
            <span class="row-title">{rowTitle(day)}</span>
            {day.note && <span class="row-note muted">{day.note}</span>}
          </span>

          <span class="time">
            {day.start ? (
              <span class="time-value">{day.start}</span>
            ) : (
              <span class="time-value dash" aria-label="čas neurčen">—</span>
            )}
            {day.isToday && <span class="time-label">DNES</span>}
          </span>
        </li>
      ))}
    </ul>
  )}

  {scheduleNote && <p class="muted footnote">{scheduleNote}</p>}
</section>

<style>
  .schedule {
    padding-block: 1rem 0;
  }

  /* Two-tone display heading: solid word + outlined word. */
  .title {
    font-size: clamp(2rem, 7vw, 3.4rem);
    margin-bottom: 0.3rem;
    text-transform: uppercase;
  }
  .outline {
    color: var(--accent);
  }
  /* Only go transparent where the stroke is actually supported, otherwise the
     word would vanish. */
  @supports (-webkit-text-stroke: 2px currentColor) {
    .outline {
      -webkit-text-stroke: 2px var(--heading-outline);
      color: transparent;
    }
  }

  .lead {
    max-width: 46ch;
    margin-bottom: 1.4rem;
  }

  .cta-wrap {
    margin-bottom: 1.6rem;
  }
  .cta {
    display: inline-block;
    padding: 0.55rem 1.3rem;
    border: 1px solid var(--card-edge);
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--text);
    background: var(--card);
  }
  .cta:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  ul {
    list-style: none;
    margin: 0 0 1.1rem;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }

  .row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--card-edge);
    border-radius: 10px;
    background:
      radial-gradient(circle at 1px 1px, var(--card-edge) 1px, transparent 0) 0 0 / 14px 14px,
      var(--card);
  }
  .row.today {
    border-color: var(--accent);
  }
  .row.off {
    opacity: 0.55;
  }

  /* Date badge */
  .badge {
    display: grid;
    justify-items: center;
    gap: 0.1rem;
    min-width: 4.1rem;
    padding: 0.45rem 0.5rem;
    border: 1px solid var(--card-edge);
    border-radius: 8px;
  }
  .today .badge {
    border-color: var(--accent);
    box-shadow: 0 0 14px -4px var(--accent);
  }
  .badge-day {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1;
  }
  .today .badge-day {
    color: var(--accent);
  }
  .badge-weekday {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  /* Middle */
  .body {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }
  .row-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .off .row-title {
    text-decoration: line-through;
  }
  .row-note {
    font-size: 0.85rem;
  }

  /* Time */
  .time {
    display: grid;
    justify-items: end;
    gap: 0.05rem;
    text-align: right;
  }
  .time-value {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--accent);
  }
  .time-value.dash {
    color: var(--muted);
  }
  .time-label {
    font-size: 0.65rem;
    letter-spacing: 0.16em;
    color: var(--muted);
  }

  .footnote {
    font-size: 0.85rem;
    margin-bottom: 0;
  }

  @media (max-width: 30rem) {
    .row {
      gap: 0.7rem;
      padding: 0.7rem 0.8rem;
    }
    .badge {
      min-width: 3.6rem;
    }
    .row-title {
      font-size: 1rem;
    }
    .time-value {
      font-size: 1.25rem;
    }
  }
</style>
