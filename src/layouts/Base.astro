---
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/rubik/400.css';
import '@fontsource/rubik/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import ScheduleBanner from '../components/ScheduleBanner.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Keep this page out of search results — the 404 page, for one. */
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;

const site = Astro.site ?? new URL('https://keoda.cz');
const pageTitle = title === 'KeodaCZ' ? title : `${title} | KeodaCZ`;
// Absolute, and trailing-slash-normalised: og:image and og:url are ignored by
// most platforms when relative, and a link shared with and without the slash
// should not count as two pages.
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), site);
const ogImage = new URL('/og.jpg', site);
const ogDescription = description ?? 'KeodaCZ — český streamer. Twitch, YouTube a spol.';
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f3edc9" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#131108" />
    <script is:inline>
      // Apply the visitor's stored theme choice before first paint.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {/* No canonical on a noindex page: it would name a real URL for content
        that is not that URL, which is worse than saying nothing. */}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    {/* .ico first for the browsers and crawlers that request /favicon.ico
        blindly; the PNG is what modern browsers actually pick. */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* Share card. Most of this site's traffic arrives from links in social
        bios, so a bare link with no preview is the one place it cannot afford
        to look unfinished. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KeodaCZ" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="KeodaCZ — zarostlé postapokalyptické město" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <Header />
    <ScheduleBanner />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
