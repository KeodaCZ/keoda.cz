# Copy to .env and fill in. .env is gitignored; this file is not and must stay
# empty of values.
#
# Use SEPARATE credentials from the ones in GitHub Actions Secrets:
#
#   Twitch  — register a second application ("keoda.cz local"). Generating a new
#             secret on the existing app replaces the old one, which would leave
#             the Actions secret invalid and break the pipeline silently.
#   YouTube — a second API key in the same Google Cloud project is fine; keys do
#             not interfere with each other. Restrict it to YouTube Data API v3.
#
# Both are read-only against public data. Revoking a local one never touches CI.
#
# Run the scripts with:  npm run fetch:clips   (etc. — see package.json)

YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
